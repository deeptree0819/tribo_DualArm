<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="soarm101_40mmUP">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import soarm101_40mmUP urdf file -->
    <xacro:include filename="$(find dt_arm_moveit_config)/config/soarm101_40mmUP.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="soarm101_40mmUP.ros2_control.xacro" />


    <xacro:soarm101_40mmUP_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
